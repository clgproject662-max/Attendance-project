# Environment Variables Example for College Attendance Management System
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/attendance_system?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a long, random secure string)
JWT_SECRET=super_secret_jwt_key_attendance_system_2026

# JWT Expiration duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# Allowed frontend origins for CORS (comma separated if multiple)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5000
